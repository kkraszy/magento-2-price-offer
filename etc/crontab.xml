<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Hourly is enough: expiry itself is enforced at checkout by Plugin\ValidateCouponPlugin -->
        <job name="kkkonrad_priceoffer_delete_expired_rules" instance="Kkkonrad\PriceOffer\Cron\DeleteExpiredRules" method="execute">
            <schedule>0 * * * *</schedule>
        </job>
    </group>
</config>
